# Chinese Energy Compliance Assistant - Environment Configuration

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Perplexity AI API Key - Required for document discovery
PPLX_API_KEY=your_perplexity_api_key_here

# Google Custom Search Engine API Key - Required for document verification
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID - Required for document verification
GOOGLE_CSE_ID=your_google_cse_id_here

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Enable online query functionality
FEATURE_ONLINE_QUERY=true

# Query processing mode: web_only, hybrid, local_first
QUERY_MODE=web_only

# Allowed domains for document retrieval (comma-separated)
ALLOWLIST_DOMAINS=*.gov.cn,*.sina.com.cn,*.people.cn

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server host
HOST=0.0.0.0

# Server port
PORT=8000

# Log level: debug, info, warning, error
LOG_LEVEL=info

# Number of worker processes (for production)
WORKERS=1

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================

# Database URL (if using database for caching)
# DATABASE_URL=postgresql://user:password@localhost:5432/energy_compliance

# Enable database caching
# USE_DATABASE_CACHE=false

# =============================================================================
# CACHE CONFIGURATION (Optional)
# =============================================================================

# Redis URL (if using Redis for caching)
# REDIS_URL=redis://localhost:6379

# Enable Redis caching
# USE_REDIS_CACHE=false

# Cache expiration time in seconds
# CACHE_EXPIRE_SECONDS=3600

# =============================================================================
# ENHANCED RETRIEVAL CONFIGURATION
# =============================================================================

# Strict refusal threshold (0.0 - 5.0)
# Documents scoring below this threshold trigger refusal responses
REFUSAL_THRESHOLD=3.0

# Enable metadata extraction
# EXTRACT_METADATA=true

# Enable canonical source prioritization
# USE_CANONICAL_SOURCES=true

# Enable query term expansion
# EXPAND_QUERY_TERMS=true

# =============================================================================
# DEBUG AND DEVELOPMENT
# =============================================================================

# Enable debug mode
DEBUG=false

# Enable detailed logging
VERBOSE_LOGGING=false

# Enable request/response logging
LOG_REQUESTS=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Maximum number of search results to process
MAX_SEARCH_RESULTS=20

# Search timeout in seconds
SEARCH_TIMEOUT=30

# Query processing timeout in seconds
QUERY_TIMEOUT=60

# Maximum number of retries for failed requests
MAX_RETRIES=3

# Delay between retries in seconds
RETRY_DELAY=2

# =============================================================================
# MONITORING AND METRICS (Optional)
# =============================================================================

# Enable Prometheus metrics
# ENABLE_METRICS=false

# Metrics port (if different from main server)
# METRICS_PORT=8001

# =============================================================================
# SECURITY (Optional)
# =============================================================================

# API key for authentication (if needed)
# API_KEY=your_api_key_here

# Enable CORS
# ENABLE_CORS=true

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# CHINESE TEXT PROCESSING
# =============================================================================

# Enable traditional to simplified Chinese conversion
# CONVERT_TRADITIONAL_TO_SIMPLIFIED=false

# Jieba dictionary path (if custom dictionary needed)
# JIEBA_DICT_PATH=

# Enable text segmentation
# ENABLE_SEGMENTATION=true
